# Backend API base URL
VITE_API_URL=http://localhost:8000

# Generic OIDC config — point at any OIDC-compliant provider.
# Register this redirect URI in your IdP: {origin}/auth/signinwin/oidc
#   e.g. http://localhost:5173/auth/signinwin/oidc
# Post-logout redirect URI: http://localhost:5173/
#
# Zitadel example: VITE_OIDC_ISSUER=http://localhost:8080
# Google example:  VITE_OIDC_ISSUER=https://accounts.google.com
VITE_OIDC_ISSUER=http://localhost:8080
VITE_OIDC_CLIENT_ID=
