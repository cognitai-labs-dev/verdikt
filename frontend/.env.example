# Frontend BFF (Nuxt/Nitro server) config — read at SERVER startup via NUXT_*
# env. Login is server-side now, so no OIDC values ever reach the browser.

# Verdikt API base URL the BFF proxies to (server-to-server).
NUXT_VERDIKT_API_URL=http://localhost:8000

# OIDC provider for human login. With the BFF, this is a CONFIDENTIAL client —
# the server holds the secret (no public PKCE-only app needed).
# Register redirect URI in the IdP: {origin}/auth/callback
#   e.g. http://localhost:3000/auth/callback
# GitLab example:  NUXT_OIDC_ISSUER=https://gitlab.example.com
# Google example:  NUXT_OIDC_ISSUER=https://accounts.google.com
# Zitadel example: NUXT_OIDC_ISSUER=http://localhost:8080
NUXT_OIDC_ISSUER=http://localhost:8080
NUXT_OIDC_CLIENT_ID=
NUXT_OIDC_CLIENT_SECRET=

# Sealed-session cookie key — must be >= 32 chars.
# Generate: openssl rand -base64 32
NUXT_SESSION_PASSWORD=
