# ─────────────────────────────────────────────────────────────────────────
# Single root .env — shared by docker-compose AND the backend (pydantic reads
# this file via an absolute path). The frontend keeps its own frontend/.env
# (Vite only exposes VITE_* and must not see these server secrets).
# ─────────────────────────────────────────────────────────────────────────

# --- App database (created by docker/init-db.sh, consumed by the backend) ---
APP_DB_USER="evaluation"
APP_DB_PASSWORD="alpharius"
APP_DB_NAME="evaluation"
# Connection target from the backend process. compose maps 5432 -> 5433.
APP_DB_HOST="localhost"
APP_DB_PORT="5433"

# --- Zitadel database (created by docker/init-db.sh for the zitadel service) ---
ZITADEL_DB_USER="zitadel"
ZITADEL_DB_PASSWORD="zitadel"
ZITADEL_DB_NAME="zitadel"

# --- LLM providers ---
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Verdikt SDK credentials (machine auth) ---
# These are Verdikt's OWN credentials, NOT the login IdP's. Machine auth does
# not use the external IdP at all — Verdikt is its own OAuth2 client_credentials
# issuer (opaque `vkt_` tokens). Mint a client with:
#   cd backend && uv run main.py create-client "<name>" [--app <slug>] [--admin]
# then paste the printed client_id / client_secret here. `make eval` uses these.
VERDIKT_CLIENT_ID=""
VERDIKT_CLIENT_SECRET=""

# --- Machine token issuer ---
# Verdikt's own public URL, advertised as the M2M issuer (what the SDK discovers
# via {SERVICE_BASE_URL}/.well-known). MACHINE_TOKEN_TTL is the token lifetime.
SERVICE_BASE_URL="http://localhost:8000"
MACHINE_TOKEN_TTL=3600

# --- Human login: generic OIDC (any OIDC-compliant provider) ---
# Verifies the id_token the frontend (PKCE) sends. Machines never use this path.
# OIDC_AUDIENCE: comma-separated accepted `aud` values — the frontend SPA client
# id(s). (No SDK id here anymore; machine tokens are not OIDC JWTs.)
# The JWKS URI is auto-discovered from {OIDC_ISSUER}/.well-known/openid-configuration.
# To pin it explicitly, set OIDC_JWKS_URI (optional).
# GitLab example:  OIDC_ISSUER="https://gitlab.example.com"
# Google example:  OIDC_ISSUER="https://accounts.google.com"
# Zitadel example: OIDC_ISSUER="http://localhost:8080"
OIDC_ISSUER="http://localhost:8080"
OIDC_AUDIENCE=""

# --- Authorization ---
# Comma-separated emails granted admin (access to EVERY app). Everyone else sees
# only the apps they are bound to (see `main.py add-member`). Machine clients use
# the --admin flag at create time instead.
ADMIN_EMAILS=""

# Comma-separated browser origins allowed via CORS. Empty by default: the
# frontend BFF reaches the API server-to-server (no browser CORS). Set only if a
# browser must call the API cross-origin.
CORS_ORIGINS=""
